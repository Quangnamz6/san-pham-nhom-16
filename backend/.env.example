# Application Settings
PROJECT_NAME="Gym AI Management System"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT=development

# Database Settings
# For SQLite (Dev): sqlite:///./gym_dev.db
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/gym_db
DATABASE_URL=sqlite:///./gym_dev.db

# JWT & Security
SECRET_KEY=supersecretjwtkey_replace_with_strong_random_hash_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Engine API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini

# CORS Settings (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
